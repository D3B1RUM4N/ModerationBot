// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//npx prisma db push
// npx prisma migrate dev --name 

model Server {
  serverID   String       @id
  serverName String
  WarnList   WarnList[]
  Role       Role[]
  Welcome    Welcome[]
  enable_xp  Boolean      @default(true)
  Experience Experience[]
  Ticket     Ticket[]

  WorkTime        WorkTime[]
  banChannels     BanChannel[]
  scheduledEvents ScheduledEvent[]
}

model Welcome {
  channelID String @id
  server    Server @relation(fields: [serverID], references: [serverID], onDelete: Cascade)
  serverID  String
}

model Role {
  roleID   String @id
  server   Server @relation(fields: [serverID], references: [serverID], onDelete: Cascade)
  serverID String
}

model WarnList {
  warnID   Int      @id @default(autoincrement())
  userID   String
  authorID String
  reason   String?
  dateWarn DateTime
  server   Server   @relation(fields: [serverID], references: [serverID], onDelete: Cascade)
  serverID String
}

model Experience {
  userID   String
  serverID String
  level    Int
  xp       Int
  server   Server @relation(fields: [serverID], references: [serverID], onDelete: Cascade)

  @@id([userID, serverID])
}

model Ticket {
  ticketID        Int             @id @default(autoincrement())
  serverID        String
  title           String
  description     String
  roleID          String
  messageID       String?
  TicketMessageID Int?
  messages        TicketMessage[]
  server          Server          @relation(fields: [serverID], references: [serverID], onDelete: Cascade)
}

model TicketMessage {
  messageID   Int    @id @default(autoincrement())
  ticketID    Int
  title       String
  description String
  ticket      Ticket @relation(fields: [ticketID], references: [ticketID], onDelete: Cascade)
}

model WorkTime {
  workTimeID    Int     @id @default(autoincrement())
  userID        String
  serverID      String
  task          String
  workTime      Int
  comment       String?
  dateWorkTime  String
  projet        String?
  estimatedTime Int?
  server        Server  @relation(fields: [serverID], references: [serverID], onDelete: Cascade)
}

model BanChannel {
  channelID String @id
  server    Server @relation(fields: [serverID], references: [serverID], onDelete: Cascade)
  serverID  String
}

model ScheduledEvent {
  eventID       Int      @id @default(autoincrement())
  serverID      String
  channelID     String
  title         String
  description   String   @db.Text
  color         String?  @default("#FF8C00")
  imageUrl      String?
  roleID        String?
  cronTime      String // Format HH:mm (ex: "12:00")
  dayOfWeek     Int // 0 = Dimanche, 1 = Lundi, ..., 5 = Vendredi, 6 = Samedi
  intervalWeeks Int      @default(1) // 1 = toutes les semaines, 2 = 1 semaine sur 2
  anchorDate    DateTime // Date de référence pour l'alternance
  paused        Boolean  @default(false)
  skipNext      Boolean  @default(false)

  // RELATION AVEC SERVER
  server Server @relation(fields: [serverID], references: [serverID], onDelete: Cascade)
}
